# Google Cloud Vertex AI & Gemini Configuration

# 1. Google Cloud Vertex AI (Enterprise / $300 Free Trial Credit)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Path to service account key file (Optional if using `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# 2. Google AI Studio (Gemini 2.5 Pro / Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend & Model Configuration
GOOGLE_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash
